# Copy this file to .env and fill in your real secrets before running.
# IDE Core Engine environment configuration.

# ------------------------------------------------------------------
# Security
# ------------------------------------------------------------------
# Change this to a strong, randomly generated secret in production.
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ------------------------------------------------------------------
# AI Provider API Keys (leave empty to disable that provider)
# ------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------------
# Default AI model and runtime behavior
# ------------------------------------------------------------------
DEFAULT_MODEL=gpt-4o
DEFAULT_TEMPERATURE=0.2

# ------------------------------------------------------------------
# Editor server binding
# ------------------------------------------------------------------
# Use 0.0.0.0 inside Docker; localhost is fine for local development.
IDE_HOST=localhost
IDE_PORT=8765

# ------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_PATH=ide_engine.log

# ------------------------------------------------------------------
# Language servers
# ------------------------------------------------------------------
LSP_PYTHON_COMMAND=pylsp
LSP_TYPESCRIPT_COMMAND=typescript-language-server --stdio

# ------------------------------------------------------------------
# Workspace scanning
# ------------------------------------------------------------------
DIRECTORY_EXCLUSIONS=["__pycache__","node_modules",".git",".venv","venv"]

# ------------------------------------------------------------------
# Multi-tenant mode
# ------------------------------------------------------------------
ENABLE_MULTI_TENANT=False
TENANT_STORAGE_PATH=.ide_tenants
BASE_DOMAIN=localhost
TENANT_CACHE_TTL=300

# ------------------------------------------------------------------
# Multimodal input
# ------------------------------------------------------------------
ENABLE_MULTIMODAL=True
ENABLE_VOICE_INPUT=True
ENABLE_IMAGE_OCR=True
ENABLE_PDF_PARSING=True
VOICE_LANGUAGE=en-US
OCR_LANGUAGE=eng

# ------------------------------------------------------------------
# Creative agent
# ------------------------------------------------------------------
ENABLE_CREATIVE_AGENT=True
ENABLE_AUTO_INSTALL=True
CREATIVE_TOOLS_PATH=.creative_tools
PREFERRED_IMAGE_MODEL=dalle
PREFERRED_TTS_MODEL=openai

# ------------------------------------------------------------------
# Smart decision / preference learning
# ------------------------------------------------------------------
ENABLE_SMART_DECISIONS=True
PREFERENCE_STORAGE_PATH=data/preferences
AUTO_LEARN_FROM_FEEDBACK=True
DECISION_EXPLAIN_LEVEL=friendly

# ------------------------------------------------------------------
# Friend personality layer
# ------------------------------------------------------------------
ENABLE_FRIEND_PERSONALITY=True
PERSONALITY_TRAITS={"friendly":0.9,"helpful":0.95,"creative":0.85}
PERSONALITY_STORAGE_PATH=data/personality
AUTO_CELEBRATE=True
AUTO_SUGGEST_HELP=True

# ------------------------------------------------------------------
# Smart AI routing
# ------------------------------------------------------------------
ENABLE_DEEPSEEK=True
ENABLE_GEMINI=True
ENABLE_SMART_ROUTING=True
ROUTING_DEFAULT_MODEL=deepseek

# ------------------------------------------------------------------
# Unified chat
# ------------------------------------------------------------------
ENABLE_CHAT=True
CHAT_WEBSOCKET_PATH=/ws/chat
CHAT_MESSAGE_HISTORY_LIMIT=100
CHAT_PRESENCE_TIMEOUT=60
CHAT_ENABLE_FRIENDS=True

# ------------------------------------------------------------------
# Security / sandboxing
# ------------------------------------------------------------------
ENABLE_SECURITY_MANAGER=True
# Comma-separated list; if non-empty, only these commands are allowed
ALLOWED_SHELL_COMMANDS=
# Comma-separated list of substrings/patterns that are always blocked
BLOCKED_SHELL_COMMANDS=rm -rf,sudo,mkfs,"dd if=",shutdown,reboot,format,"> /dev/","| sh","curl |","wget |"
# Comma-separated list of substrings/patterns that require user confirmation
REQUIRE_CONFIRMATION_PATTERNS="rm ",sudo,"git push","git reset","git clean",docker,curl,wget,"pip install","npm install",yarn
AUDIT_LOG_PATH=security.log
